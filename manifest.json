{
  "manifest_version": 2,
  "name": "ESE Printer - eBay Label Automation",
  "version": "1.0",
  "description": "Automatically handles eBay label printing flow and manages tabs",
  "permissions": [
    "tabs",
    "*://*.ebay.com/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [{
    "matches": [
      "*://*.ebay.com/*"
    ],
    "js": ["content.js"],
    "run_at": "document_end"
  }],
  "icons": {
    "16": "icons/favicon-16x16.png",
    "48": "icons/favicon-32x32.png",
    "128": "icons/android-chrome-192x192.png"
  }
}
